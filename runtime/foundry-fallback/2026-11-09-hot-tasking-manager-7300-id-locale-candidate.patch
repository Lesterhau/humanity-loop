diff --git a/frontend/src/utils/tests/idEditorLocale.test.js b/frontend/src/utils/tests/idEditorLocale.test.js
new file mode 100644
--- /dev/null
+++ b/frontend/src/utils/tests/idEditorLocale.test.js
@@ -0,0 +1,28 @@
+import { normalizeIdEditorLocale } from '../idEditorContext';
+
+describe('normalizeIdEditorLocale', () => {
+  test('converts HOT Dutch locale to BCP47 for iD', () => {
+    expect(normalizeIdEditorLocale('nl_NL')).toBe('nl-NL');
+    expect(new Intl.Locale(normalizeIdEditorLocale('nl_NL')).language).toBe('nl');
+  });
+
+  test('shows why the original identifier fails in iD 2.41.2', () => {
+    expect(() => new Intl.Locale('nl_NL')).toThrow(RangeError);
+  });
+
+  test('normalizes other underscore variants', () => {
+    expect(normalizeIdEditorLocale('zh_TW')).toBe('zh-TW');
+    expect(normalizeIdEditorLocale('fa_IR')).toBe('fa-IR');
+  });
+
+  test('preserves existing BCP47 identifiers and base locales', () => {
+    expect(normalizeIdEditorLocale('pt-BR')).toBe('pt-BR');
+    expect(normalizeIdEditorLocale('cs')).toBe('cs');
+  });
+
+  test('falls back to English on missing or malformed values', () => {
+    for (const value of [undefined, null, '', ' ', 'invalid_locale_!']) {
+      expect(normalizeIdEditorLocale(value)).toBe('en');
+    }
+  });
+});
