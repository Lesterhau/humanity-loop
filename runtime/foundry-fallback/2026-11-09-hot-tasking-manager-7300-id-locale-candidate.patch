diff --git a/frontend/src/utils/idEditorContext.js b/frontend/src/utils/idEditorContext.js
--- a/frontend/src/utils/idEditorContext.js
+++ b/frontend/src/utils/idEditorContext.js
@@ -1,3 +1,15 @@
+// Tasking Manager stores some locales as xx_YY (e.g. nl_NL), but iD's
+// localizer passes its preferred locale to Intl.Locale (BCP 47: xx-YY).
+// Normalize only at the embedded iD boundary, not the TM/Transifex locale.
+export function normalizeIdEditorLocale(locale) {
+  if (typeof locale !== 'string' || !locale.trim()) return 'en';
+  try {
+    return Intl.getCanonicalLocales(locale.trim().replace(/_/g, '-'))[0] || 'en';
+  } catch {
+    return 'en';
+  }
+}
+
 const backgroundsWithFilteredImagery = new WeakSet();
 const unavailableImagerySourceIds = new Set(['OpenAerialMapMosaic']);
 
