diff --git a/policyengine_us/variables/gov/states/nh/dhhs/fanf/nh_fanf.py b/policyengine_us/variables/gov/states/nh/dhhs/fanf/nh_fanf.py
--- a/policyengine_us/variables/gov/states/nh/dhhs/fanf/nh_fanf.py
+++ b/policyengine_us/variables/gov/states/nh/dhhs/fanf/nh_fanf.py
@@ -17,4 +17,8 @@
         payment_standard = spm_unit("nh_fanf_payment_standard", period)
         countable_income = spm_unit("nh_fanf_countable_income", period)
         benefit = max_(payment_standard - countable_income, 0)
-        return min_(benefit, payment_standard)
+        capped_benefit = min_(benefit, payment_standard)
+        # He-W 670.03(b)(3)-(5): round the grant down, then suppress grants below $10.
+        rounded_grant = np.floor(np.round(capped_benefit, 2))
+        minimum_grant = parameters(period).gov.states.nh.dhhs.fanf.minimum_grant
+        return where(rounded_grant >= minimum_grant, rounded_grant, 0)
diff --git a/policyengine_us/parameters/gov/states/nh/dhhs/fanf/minimum_grant.yaml b/policyengine_us/parameters/gov/states/nh/dhhs/fanf/minimum_grant.yaml
new file mode 100644
--- /dev/null
+++ b/policyengine_us/parameters/gov/states/nh/dhhs/fanf/minimum_grant.yaml
@@ -0,0 +1,10 @@
+description: New Hampshire does not issue a monthly FANF grant below this amount before adjustments.
+values:
+  2021-12-17: 10
+metadata:
+  unit: currency-USD
+  period: month
+  label: New Hampshire FANF minimum monthly grant
+  reference:
+    - title: N.H. Admin. Rules He-W 670.03(b)(4)-(5)
+      href: https://gc.nh.gov/rules/state_agencies/he-w600.html
