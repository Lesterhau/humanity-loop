+from policyengine_us.model_api import *
+
+
+class ms_tanf_is_assistance_unit_member(Variable):
+    value_type = bool
+    entity = Person
+    label = "Mississippi TANF assistance unit member"
+    definition_period = MONTH
+    default_value = True
+    defined_for = StateCode.MS
+    reference = (
+        "https://www.sos.ms.gov/adminsearch/ACCode/00000330c.pdf#page=192",
+        "https://www.sos.ms.gov/adminsearch/ACCode/00000330c.pdf#page=458",
+    )
+
+    def formula(person, period, parameters):
+        # SSI recipients are excluded even if their modeled payment is zero
+        # but receipt is reported. Other special exclusion codes are not yet
+        # represented by this variable; see the manual and issue #10516.
+        is_ssi_recipient = (person("ssi", period) > 0) | (
+            person("receives_ssi", period) > 0
+        )
+        return ~is_ssi_recipient
