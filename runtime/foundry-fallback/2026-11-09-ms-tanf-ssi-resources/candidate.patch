-        return household_assets <= p.limit
+        person = spm_unit.members
+        is_member = person("ms_tanf_is_assistance_unit_member", period)
+
+        # spm_unit_cash_assets is the sum of these person-level components.
+        # When it is independently overridden, ownership cannot be inferred;
+        # retain the full aggregate rather than silently exempting assets.
+        person_assets = (
+            person("bank_account_assets", period.this_year)
+            + person("stock_assets", period.this_year)
+            + person("bond_assets", period.this_year)
+        )
+        all_person_assets = spm_unit.sum(person_assets)
+        included_assets = spm_unit.sum(person_assets * is_member)
+        countable_assets = where(
+            abs(all_person_assets - household_assets) <= 0.01,
+            included_assets,
+            household_assets,
+        )
+        return countable_assets <= p.limit
